# PrismaCoder environment configuration (copy to .env and fill in).
# Never commit the filled-in .env file.

# --- GitHub crawling (Phase 1: PrismaForge mining) ---
# A GitHub personal access token raises the rate limit from 60 to 5000 req/h.
# Scope: public_repo read access is sufficient. https://github.com/settings/tokens
GITHUB_TOKEN=

# --- HuggingFace release (Phase 3/5) ---
# Token with write access to the `prismacoder` org. https://huggingface.co/settings/tokens
HF_TOKEN=
HF_USERNAME=prismacoder

# --- Verification sandbox (Phase 1d) ---
# Node.js >= 18.18 must be on PATH for the V1-V5 gates. Leave empty to auto-detect.
NODE_BIN=
NPM_BIN=
# Verification job timeout in seconds (per gate).
VERIFY_TIMEOUT_SECONDS=300
# Run gates inside the docker sandbox instead of on the host (requires docker).
VERIFY_DOCKER=0

# --- Postgres execution gate (optional; V4 postgres lane) ---
VERIFY_POSTGRES_URL=postgresql://prisma:prisma@localhost:5432/prismacoder

# --- PrismaBench private split (maintainers only; never commit the key) ---
PRISMABENCH_PRIVATE_KEY=
